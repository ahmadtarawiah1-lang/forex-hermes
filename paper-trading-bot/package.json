  "private": true,
  "description": "Paper-trading bot for BTCUSDT (5m, 9/21 MA crossover) with a raw and memory-enabled replay path. No live trading.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "scan": "ts-node src/index.ts scan",
    "replay:raw": "ts-node src/index.ts replay:raw",
    "replay:memory": "ts-node src/index.ts replay:memory",
    "memory:reset": "ts-node src/index.ts memory:reset"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
